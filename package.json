{
  "name": "coursary-api",
  "version": "0.0.0",
  "private": true,
  "description": "API serverless de uma plataforma de cursos (Lambda + DynamoDB single-table).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "build:layers": "scripts/build-layers.sh && scripts/check-layers.sh",
    "sls:package": "pnpm build:layers && sls package --stage dev",
    "check:bundles": "pnpm build:layers && node scripts/check-bundles.js",
    "deploy:dev": "scripts/check-deploy-env.sh && pnpm build:layers && sls deploy --stage dev",
    "remove:dev": "sls remove --stage dev",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "e2e:dev": "node --env-file=.env scripts/e2e-dev.js"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "serverless": "4.43.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1149.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sesv2": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "algoliasearch": "5.59.0",
    "ksuid": "3.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-email": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
